{
  "name": "Sample Webhook to Log",
  "nodes": [
    {
      "parameters": {
        "path": "sample-log",
        "methods": ["POST"]
      },
      "id": "Webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [300, 300]
    },
    {
      "parameters": {
        "url": "http://automation_backend:8080/api/logs",
        "options": {},
        "jsonParameters": true,
        "responseFormat": "json",
        "bodyParameters": [
          {
            "name": "workflow_id",
            "value": "={{ $workflow.id }}"
          },
          {
            "name": "execution_id",
            "value": "={{ $execution.id }}"
          },
          {
            "name": "status",
            "value": "running"
          },
          {
            "name": "duration_ms",
            "value": 0
          },
          {
            "name": "message",
            "value": "={{ $json.message || '' }}"
          }
        ]
      },
      "id": "HTTP Request",
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [520, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "HTTP Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "timezone": "UTC"
  }
}
