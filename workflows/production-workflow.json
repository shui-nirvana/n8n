{
  "name": "Production-Grade Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-signup",
        "options": {}
      },
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.body.type}}",
              "value2": "vip"
            }
          ]
        }
      },
      "name": "Check VIP Status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "url": "http://crm-service/api/vip-onboarding",
        "method": "POST",
        "jsonParameters": true,
        "options": {
          "response": {
            "response": {
              "fullResponse": true
            }
          }
        },
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "email",
              "value": "={{$node[\"Webhook Trigger\"].json.body.email}}"
            }
          ]
        }
      },
      "name": "CRM Integration (VIP)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [700, 200],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "url": "http://crm-service/api/standard-onboarding",
        "method": "POST",
        "jsonParameters": true,
        "options": {},
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "email",
              "value": "={{$node[\"Webhook Trigger\"].json.body.email}}"
            }
          ]
        }
      },
      "name": "CRM Integration (Standard)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [700, 400]
    },
    {
      "parameters": {
        "url": "http://backend:8080/api/logs",
        "method": "POST",
        "jsonParameters": true,
        "options": {},
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "workflow_id",
              "value": "={{$workflow.id}}"
            },
            {
              "name": "execution_id",
              "value": "={{$execution.id}}"
            },
            {
              "name": "status",
              "value": "success"
            },
            {
              "name": "message",
              "value": "Lead processed successfully"
            }
          ]
        }
      },
      "name": "Log Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [1000, 300]
    },
    {
      "parameters": {},
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [250, 600]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 0 * * *"
            }
          ]
        }
      },
      "name": "Nightly Schedule",
      "type": "n8n-nodes-base.schedule",
      "typeVersion": 1,
      "position": [250, 450]
    },
    {
      "parameters": {
        "url": "http://backend:8080/api/logs",
        "method": "POST",
        "jsonParameters": true,
        "options": {},
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "workflow_id",
              "value": "={{$workflow.id}}"
            },
            {
              "name": "execution_id",
              "value": "={{$execution.id}}"
            },
            {
              "name": "status",
              "value": "error"
            },
            {
              "name": "message",
              "value": "={{$node[\"Error Trigger\"].json.message}}"
            }
          ]
        }
      },
      "name": "Log Error",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [450, 600]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Check VIP Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check VIP Status": {
      "main": [
        [
          {
            "node": "CRM Integration (VIP)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "CRM Integration (Standard)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CRM Integration (VIP)": {
      "main": [
        [
          {
            "node": "Log Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "CRM Integration (Standard)": {
      "main": [
        [
          {
            "node": "Log Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Log Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Nightly Schedule": {
      "main": [
        [
          {
            "node": "Log Success",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
